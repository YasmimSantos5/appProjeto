<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="16dp"
    tools:context=".activity.PainelActivity">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:background="#5B21B6"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Painel do Morador"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bem-vindo!"
            android:textColor="#D8C8FF"
            android:textSize="16sp"/>

    </LinearLayout>

    <!-- BOLETO -->

    <Button
        android:id="@+id/btnBoleto"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#6D28D9"
        android:elevation="8dp"
        android:text="Boleto"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/botaoReserva" />

    <!-- RESERVA -->

    <Button
        android:id="@+id/botaoReserva"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:backgroundTint="#7C3AED"
        android:elevation="8dp"
        android:text="Reserva"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toTopOf="@id/btnBoleto"
        app:layout_constraintStart_toEndOf="@id/btnBoleto"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- AUTORIZAÇÃO -->

    <Button
        android:id="@+id/buttonAutorizacaoPainel"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#8B5CF6"
        android:elevation="8dp"
        android:text="Autorização"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:cornerRadius="24dp"
        app:layout_constraintStart_toStartOf="@id/btnBoleto"
        app:layout_constraintTop_toBottomOf="@id/btnBoleto" />

    <!-- MURAL -->

    <!-- PORTARIA -->

    <Button
        android:id="@+id/BtnMural"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#9333EA"
        android:elevation="8dp"
        android:text="Mural"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="@+id/botaoReserva"
        app:layout_constraintTop_toBottomOf="@+id/botaoReserva" />

    <!-- MUDANÇA -->

    <Button
        android:id="@+id/btnPortaria"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#A855F7"
        android:elevation="8dp"
        android:text="Portaria"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.138"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonAutorizacaoPainel" />

    <Button
        android:id="@+id/btnmudanca"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#C084FC"
        android:elevation="8dp"
        android:text="Mudança"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="@+id/BtnMural"
        app:layout_constraintTop_toBottomOf="@+id/BtnMural" />

</androidx.constraintlayout.widget.ConstraintLayout>