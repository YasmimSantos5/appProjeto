<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.MuralActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarMural2"
        android:layout_width="409dp"
        android:layout_height="wrap_content"
        android:background="#5B21B6"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Comunicados"
        app:titleTextColor="#F4F4F4" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/RecylerViewMural"
        android:layout_width="404dp"
        android:layout_height="513dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarMural2" />

    <Button
        android:id="@+id/Btnvoltarpainel"
        android:layout_width="381dp"
        android:layout_height="40dp"
        android:layout_marginBottom="60dp"
        android:text="Voltar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.533"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/RecylerViewMural" />

</androidx.constraintlayout.widget.ConstraintLayout>